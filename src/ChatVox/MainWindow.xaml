<Window x:Class="ChatVox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatVox" Icon="assets/branding/ChatVox.ico"
        MinWidth="760" MinHeight="600" ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <Grid Margin="20" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="ChatVox" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Twitch chat text to speech" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Appearance" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><ComboBox x:Name="Appearance" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="System"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox></StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Ellipse x:Name="TwitchDot" Width="10" Height="10" Fill="#F0A83A" Margin="0,5,8,0"/><TextBlock x:Name="TwitchStatus" Text="Twitch  Authorization Required" FontWeight="SemiBold"/></StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse x:Name="TtsDot" Width="10" Height="10" Fill="#53C47A" Margin="0,5,8,0"/><TextBlock x:Name="TtsStatus" Text="TTS  Ready"/></StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse x:Name="QueueDot" Width="10" Height="10" Fill="#53C47A" Margin="0,5,8,0"/><TextBlock x:Name="QueueStatus" Text="Queue  0 / 6"/></StackPanel>
            </StackPanel>
            <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect Twitch" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Click="Connect"/>
          </Grid>
        </Border>

        <GroupBox Grid.Row="2" Header="VOICE">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ComboBox x:Name="Voice" MaxDropDownHeight="420" SelectionChanged="SettingsChanged"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="6,8,0,3"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="10,2"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="75"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Speed" VerticalAlignment="Center"/><Slider x:Name="Speed" Grid.Column="1" Minimum="0.5" Maximum="2" ValueChanged="SettingsChanged"/><TextBlock x:Name="SpeedValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="Volume" VerticalAlignment="Center" Margin="14,0,0,0"/><Slider x:Name="Volume" Grid.Column="4" Minimum="0" Maximum="1" ValueChanged="SettingsChanged"/><TextBlock x:Name="VolumeValue" Grid.Column="5" VerticalAlignment="Center" TextAlignment="Right"/></Grid>
            <CheckBox x:Name="ReadNames" Style="{StaticResource ChatVoxToggle}" Grid.Row="2" Content="Read usernames" IsChecked="True" Margin="0,12,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
          </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="CHAT READER">
          <StackPanel>
            <WrapPanel><Button x:Name="PauseButton" Content="Pause" Click="TogglePause"/><Button Content="Clear Queue" Click="Clear"/><Button Content="Stop Speaking" Click="Stop"/></WrapPanel>
            <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="IgnoreCommands" Style="{StaticResource ChatVoxToggle}" Content="Ignore !commands" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,18,0"/><CheckBox x:Name="IgnoreUrls" Style="{StaticResource ChatVoxToggle}" Content="Ignore URLs" Checked="SettingsChanged" Unchecked="SettingsChanged"/></WrapPanel>
            <StackPanel Margin="0,10,0,0"><TextBlock Text="Ignored users (comma-separated)" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBox x:Name="IgnoredUsers" LostFocus="SettingsChanged"/></StackPanel>
            <UniformGrid Columns="4" Margin="0,12,0,0"><StackPanel Margin="0,0,8,0"><TextBlock Text="Max queue" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBox x:Name="MaxQueue" LostFocus="SettingsChanged"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Max age (sec)" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBox x:Name="MaxAge" LostFocus="SettingsChanged"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Gap (ms)" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBox x:Name="SpeechGap" LostFocus="SettingsChanged"/></StackPanel><StackPanel><TextBlock Text="Max message length" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBox x:Name="MaxLength" LostFocus="SettingsChanged"/></StackPanel></UniformGrid>
            <StackPanel Margin="0,12,0,0"><TextBlock Text="WINDOWS" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/><WrapPanel Margin="0,5,0,0"><CheckBox x:Name="StartWithWindows" Style="{StaticResource ChatVoxToggle}" Content="Start ChatVox with Windows" Checked="StartupWithWindowsChanged" Unchecked="StartupWithWindowsChanged" Margin="0,0,18,0"/><CheckBox x:Name="StartMinimized" Style="{StaticResource ChatVoxToggle}" Content="Start minimized to tray" Checked="SettingsChanged" Unchecked="SettingsChanged"/></WrapPanel></StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="TEST VOICE"><StackPanel><TextBox x:Name="TestText" Text="Hello. Twitch chat text to speech is ready."/><Button Content="Test Voice" Margin="0,10,0,0" Click="Test" HorizontalAlignment="Left"/></StackPanel></GroupBox>

        <GroupBox Grid.Row="5" Header="DIAGNOSTICS">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="DiagnosticsText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="125" MaxHeight="260"/>
            <Button x:Name="CopyDiagnosticsButton" Grid.Column="1" Content="Copy Diagnostics" VerticalAlignment="Top" Click="CopyDiagnostics" Margin="12,0,0,0"/>
          </Grid>
        </GroupBox>

        <GroupBox Grid.Row="6" Header="ABOUT &amp; UPDATES">
          <StackPanel><TextBlock Text="ChatVox  •  Live Chat TTS Reader" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/><TextBlock Text="Reads Twitch chat aloud using local text-to-speech." Margin="0,8,0,0"/><WrapPanel Margin="0,8,0,0"><CheckBox x:Name="AutomaticUpdates" Style="{StaticResource ChatVoxToggle}" Content="Check for updates at startup" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,12,0"/><TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="UpdateChannelSelector" Width="100" SelectionChanged="SettingsChanged" Margin="0,0,12,0"><ComboBoxItem Content="Stable"/><ComboBoxItem Content="Preview"/></ComboBox><Button Content="Check for Updates" Click="CheckForUpdates"/><Button x:Name="UpdateActionButton" Content="Download &amp; Install" Click="DownloadAndInstallUpdate" Visibility="Collapsed"/></WrapPanel><TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="Created by Drakcain  •  Twitch integration powered by Twitch API / EventSub  •  Voice synthesis powered by Kokoro" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </GroupBox>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
